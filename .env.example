# Application
NODE_ENV=development
PORT=3000

# Database (TypeORM uses DATABASE_URL when set; otherwise DB_* below)
#
# Port recap (see docker-compose.yml for current host ports, e.g. Postgres published on 5434):
# - App runs IN Docker: keep db:5432 (service name + internal port). compose also sets this for you.
# - App runs ON YOUR MAC but DB is in Docker: use localhost and the published host port:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5434/etss
#   DB_HOST=localhost
#   DB_PORT=5434
# - App and Postgres both local (no Docker): localhost + 5432.
DATABASE_URL=postgres://postgres:postgres@db:5432/etss
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=maritime_etss

# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP (MailHog in Docker: from the app container use mailhog:1025; from your Mac use localhost:1026 for SMTP, http://localhost:8025 for UI)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# JWT
JWT_SECRET=supersecret
JWT_EXPIRATION=1d

# Optional
CORS_ORIGIN=*

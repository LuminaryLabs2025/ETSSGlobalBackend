# Application
NODE_ENV=development
PORT=3000

# Database
#
# TypeORM and `npm run seed` use DATABASE_URL when set; otherwise DB_*.
#
# docker-compose.yml publishes Postgres as localhost:5438 → database `etss` (user/pass postgres).
#
# - App IN Docker: compose sets DB_* and DATABASE_URL to host `db`, port 5432 — you can omit overrides.
# - Seed / Nest ON YOUR MAC with DB in Docker: use localhost and the published port (see compose):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5438/etss
#   DB_HOST=localhost
#   DB_PORT=5438
#   DB_NAME=etss
# - Postgres only on your Mac (no Docker): usually localhost:5432 and your real DB name/password.
DATABASE_URL=postgres://postgres:postgres@localhost:5438/etss
DB_HOST=localhost
DB_PORT=5438
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=etss

# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP — Resend (local + Docker Compose load this via env_file; docker-compose does not override these)
# Docs: https://resend.com/docs/send-with-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
# Port 465: set SMTP_SECURE=true. Port 587: leave SMTP_SECURE unset.
# SMTP_SECURE=true
# Use a verified domain sender in production; Resend may allow onboarding@resend.dev for testing.
# Quote the whole value — bare < breaks Docker Compose’s .env parser.
SMTP_FROM='Maritime ETSS <onboarding@resend.dev>'

# JWT
JWT_SECRET=supersecret
JWT_EXPIRATION=1d

# Optional
CORS_ORIGIN=*

# ── Database seeding ──
# Local / CI: npm run seed   |   Docker (app already up): npm run seed:docker
# One-off compose job: docker compose --profile seed run --rm seed
#
# Production image: set RUN_SEED_ON_DEPLOY=true to run compiled seeds before node dist/main.js
# (idempotent; safe for deploy pipelines that should ensure reference data exists)
RUN_SEED_ON_DEPLOY=false

# Bootstrap super admin (override in production)
SEED_SUPER_ADMIN_EMAIL=admin@etss.com
SEED_SUPER_ADMIN_PASSWORD=password123
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin

# Application
NODE_ENV=development
PORT=3000

# Database
#
# TypeORM and `npm run seed` use DATABASE_URL when set; otherwise DB_*.
#
# Managed Postgres (Aiven, Neon, etc.): use `?sslmode=require` on DATABASE_URL, or set
# DATABASE_SSL=true when using only DB_* vars (the URL query is not applied after parsing).
#
# docker-compose.yml publishes Postgres as localhost:5438 → database `etss` (user/pass postgres).
#
# - App IN Docker: compose sets DB_* and DATABASE_URL to host `db`, port 5432 — you can omit overrides.
# - Seed / Nest ON YOUR MAC with DB in Docker: use localhost and the published port (see compose):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5438/etss
#   DB_HOST=localhost
#   DB_PORT=5438
#   DB_NAME=etss
# - Postgres only on your Mac (no Docker): usually localhost:5432 and your real DB name/password.
DATABASE_URL=postgres://postgres:postgres@localhost:5438/etss
# DATABASE_SSL=true
DB_HOST=localhost
DB_PORT=5438
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=etss

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6383

# SMTP — Brevo (local + Docker Compose load this via env_file; docker-compose does not override these)
# Docs: https://developers.brevo.com/docs/send-a-transactional-email
#
# Testing without provider recipient limits:
# 1) Log only (no network; use any invite email in the app — creds appear in container logs):
#    SMTP_MODE=log
# 2) Mailpit (fake SMTP; open http://localhost:8025). Compose: docker compose --profile mail up -d
#    SMTP_HOST=mailpit
#    SMTP_PORT=1025
#    (omit SMTP_USER / SMTP_PASS or leave empty)
#
SMTP_HOST=smtp-relay.brevo.com
# Brevo supports 587, 465, 2525 — if 587 times out (ETIMEDOUT) on your host, try 2525.
SMTP_PORT=587
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=
# Set to "log" in non-production to skip SMTP (see note above). Never use in production.
SMTP_MODE=
# Port 465: set SMTP_SECURE=true. Port 587: leave SMTP_SECURE unset.
# SMTP_SECURE=true
# Use a verified sender/domain in production from your Brevo account.
# Quote the whole value — bare < breaks Docker Compose’s .env parser.
SMTP_FROM='Maritime ETSS <noreply@yourdomain.com>'
#
# If your SMTP provider restricts recipients in testing mode, set this to an inbox you control
# so invites still deliver while the body shows the real invitee’s login email:
# SMTP_REDIRECT_TO=you@yourcompany.com
SMTP_REDIRECT_TO=

# JWT
JWT_SECRET=supersecret
JWT_EXPIRATION=1d

# Optional
CORS_ORIGIN=*
APP_NAME=Maritime ETSS

# Frontend URL used for invite + password-reset links sent by email
FRONTEND_URL=https://etss-global.onrender.com
JOIN_INVITE_PATH=/join-invite
RESET_PASSWORD_PATH=/reset-password

# ── Database seeding ──
# Local / CI: npm run seed   |   Docker (app already up): npm run seed:docker
# One-off compose job: docker compose --profile seed run --rm seed
#
# Production image: set RUN_SEED_ON_DEPLOY=true to run compiled seeds before node dist/main.js
# (idempotent; safe for deploy pipelines that should ensure reference data exists)
RUN_SEED_ON_DEPLOY=false
# Production image: set true to run pending migrations before app boot.
RUN_MIGRATIONS_ON_DEPLOY=false

# Bootstrap super admin (override in production)
SEED_SUPER_ADMIN_EMAIL=admin@etss.com
SEED_SUPER_ADMIN_PASSWORD=password123
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
